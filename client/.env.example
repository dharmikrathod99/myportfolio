# Frontend Environment Variables (Vercel / Production Deployment)
# Google Gemini API Key for Diykan Voice Assistant (Set in Vercel / Netlify dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: In production on Vercel, set this to your Render backend URL (e.g., https://dharmik-portfolio-server.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Local Daykan Kokoro-82M TTS direct fallback endpoint (Optional)
KOKORO_TTS_URL=http://127.0.0.1:8880
