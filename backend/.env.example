# Server Environment Variables
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:3000,https://your-portfolio.vercel.app

# Daykan Conversational AI (GPT-OSS-20B)
GPT_OSS_ENDPOINT=https://integrate.api.nvidia.com/v1
GPT_OSS_API_KEY=your_gpt_oss_api_key_here
GPT_OSS_MODEL=gpt-oss-20b

# Local Daykan Kokoro-82M TTS (CPU Compatible, Zero API keys needed)
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_SPEED=1.0

# Local Daykan Magpie TTS Multilingual (Zero API keys needed locally)
MAGPIE_TTS_BASE_URL=http://127.0.0.1:8012
MAGPIE_TTS_VOICE=Aria

